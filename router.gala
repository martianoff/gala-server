package server

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/concurrent"
)

// Route binds an HTTP method + pattern to a handler.
// Patterns use Go 1.22+ syntax: "/users/{id}", "/files/{path...}"
struct Route(Method Method, Pattern string, Handler Handler, Name string)

// liftHandler wraps a sync handler into an async Handler. The handler runs on
// the calling (per-request) goroutine — nothing crosses a Future's Sendable
// boundary (spawning it would have captured the unshareable Request). Try
// catches a panicking handler synchronously and surfaces it as a FAILED Future
// (preserving the previous spawn-in-a-Future panic semantics), so an upstream
// Recovery filter can turn it into a 500; a clean result becomes a completed
// Future via FutureOf.
func liftHandler(handler func(Request) Response) Handler =
    (req Request) => Try(() => handler(req)) match {
        case Success(resp) => FutureOf(resp)
        case Failure(err)  => FutureFailed[Response](err)
    }

// applyFilters wraps a handler with an Array of filters (outermost first).
func applyFilters(handler Handler, filters Array[Filter]) Handler =
    filters.FoldRight(handler, (f, inner) => (req Request) => callFilter(f, req, inner))

func callFilter(f Filter, req Request, inner Handler) Future[Response] = f(req, inner)
