package main

import (
    . "github.com/martianoff/gala-server"
    gs "martianoff/gala/strings"
    "strconv"
    "time"
)

// =============================================================================
// GALA Server — TCP (non-HTTP protocol) demo
// =============================================================================
//
// Run:   bazel run //examples/tcp-echo
// Try:   nc localhost 7070      (or telnet localhost 7070)
//
// A `Server` is protocol-agnostic: it owns identity, port, banner, warmup and
// graceful shutdown. `ServeHTTP` makes it speak HTTP; `ServeTCP` makes it speak
// whatever you write. Redis's RESP, memcached, SMTP and line-oriented control
// ports all need a byte stream rather than a router. See docs/tcp.md.
//
// The two coexist happily in one binary — see the note at the bottom.
//
// This example implements a tiny line protocol:
//
//   ECHO <text>   -> <text>
//   LEN <n>       -> reads exactly n more bytes, replies with what it read
//   TIME          -> a counter, to show per-connection state
//   QUIT          -> closes the connection
//   anything else -> ERR unknown command

val maxLine = 8 * 1024

// handle runs one connection to completion.
//
// It is a top-level function taking the Conn, not a closure over enclosing
// state. That shape keeps every connection independently readable, which
// matters because Serve runs each one concurrently.
func handle(c Conn) {
    Println(s"connect ${c.RemoteAddr()}")
    var running = true
    var count = 0

    for running {
        c.ReadLine(maxLine) match {
            // None means the peer closed, or the line exceeded maxLine.
            case None() => {
                running = false
            }
            case Some(line) => {
                count = count + 1
                running = respond(c, line, count)
            }
        }

        // Flush only when nothing further is already buffered. A client that
        // pipelines several commands in one write then gets one syscall back
        // instead of one per reply.
        if !running || c.Buffered() == 0 {
            c.Flush()
        }
    }

    Println(s"disconnect ${c.RemoteAddr()} after $count command(s)")
    c.Close()
}

// respond writes the reply for one line and reports whether to keep going.
func respond(c Conn, line string, count int) bool {
    if line == "QUIT" {
        c.Write("BYE\r\n")
        return false
    }
    if line == "TIME" {
        c.Write(s"COMMANDS ${strconv.Itoa(count)}\r\n")
        return true
    }
    if gs.HasPrefix(line, "ECHO ") {
        c.Write(gs.S(line).Drop(5).ToString() + "\r\n")
        return true
    }
    if gs.HasPrefix(line, "LEN ") {
        val n, err = strconv.Atoi(gs.S(line).Drop(4).ToString())
        if err != nil || n < 0 {
            c.Write("ERR bad length\r\n")
            return true
        }
        // Length-driven read: the payload may contain CRLF or NUL bytes, so it
        // cannot be read to a delimiter. The second argument is how many
        // trailing bytes to discard — 2 for the CRLF this protocol sends after
        // the payload.
        c.ReadExactly(n, 2) match {
            case Some(payload) => {
                c.Write(s"GOT ${strconv.Itoa(payload.ByteSize())} $payload\r\n")
            }
            case None() => {
                c.Write("ERR short read\r\n")
            }
        }
        return true
    }
    c.Write("ERR unknown command\r\n")
    return true
}

func main() {
    // The Server owns identity, port and lifecycle; ServeTCP hands it the
    // protocol. On Ctrl+C it stops accepting, lets in-flight connections
    // finish, and force-closes whatever is left after ShutdownTimeout.
    NewServer().
        WithName("tcp-echo").
        WithPort(7070).
        WithShutdownTimeout(10 * time.Second).
        ServeTCP(handle) match {
            case Success(_) => {}
            case Failure(e) => { Println(s"serve failed: ${e.Error()}") }
        }
}

// =============================================================================
// Running an HTTP server AND a TCP listener in one binary
// =============================================================================
//
// They are independent, so this is just two ports:
//
//   func main() {
//       // Admin/metrics over HTTP, on its own port
//       go_interop.Spawn(() =>
//           NewServer().WithPort(8080).ServeHTTP(NewHTTP().
//               WithHealthCheck("/health").
//               WithMetricsEndpoint("/metrics", NewMetrics())))
//
//       // The protocol itself over TCP
//       NewServer().WithPort(7070).ServeTCP(handle)
//   }
//
// That is the shape a real protocol server wants: the protocol on its own
// port, and HTTP for the things HTTP is good at — health checks, Prometheus
// scraping, an admin API.
//
// =============================================================================
// Try it
// =============================================================================
//
//   $ nc localhost 7070
//   ECHO hello
//   hello
//   TIME
//   COMMANDS 2
//   LEN 5
//   abcde
//   GOT 5 abcde
//   QUIT
//   BYE
