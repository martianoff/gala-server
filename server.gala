package server

import (
    . "martianoff/gala/collection_immutable"
    "time"
)

// Server is the protocol-agnostic host: identity, port, and lifecycle.
//
// It knows how to bind a port, print a startup banner, run a warmup hook, and
// shut down gracefully. It knows nothing about routes, filters, or framing —
// those belong to a protocol, which you hand it:
//
//   // HTTP
//   NewServer().
//       WithName("my-api").
//       WithPort(8080).
//       ServeHTTPGraceful(NewHTTP().
//           GET("/", handler).
//           WithFilter(Logger()))
//
//   // A protocol that is not HTTP
//   NewServer().
//       WithName("gala-kv").
//       WithPort(6379).
//       WithShutdownTimeout(15 * time.Second).
//       ServeTCP(handle)
//
// The split is why port and shutdown configuration are written once rather than
// once per protocol: a Redis server wants a graceful drain for exactly the same
// reason an HTTP server does.
type Server struct {
    Port            int
    Name            string
    ShutdownTimeout time.Duration
    Debug           bool
    Banner          bool
    warmup          Option[WarmupFunc]
}

// NewServer creates a Server with default settings (port 8080).
func NewServer() Server = Server(
    Port = 8080,
    Name = "GALA Server",
    ShutdownTimeout = 30 * time.Second,
    Debug = false,
    Banner = true,
    warmup = None[WarmupFunc](),
)

// --- Configuration ---

func (s Server) copy(
    port int = s.Port,
    name string = s.Name,
    timeout time.Duration = s.ShutdownTimeout,
    debug bool = s.Debug,
    banner bool = s.Banner,
    wu Option[WarmupFunc] = s.warmup,
) Server = Server(port, name, timeout, debug, banner, wu)

// WithPort sets the port the server listens on.
func (s Server) WithPort(port int) Server = s.copy(port = port)

// WithName sets the server name shown in the startup banner.
func (s Server) WithName(name string) Server = s.copy(name = name)

// WithShutdownTimeout sets the graceful shutdown timeout duration.
func (s Server) WithShutdownTimeout(timeout time.Duration) Server =
    s.copy(timeout = timeout)

// WithDebug enables debug mode (verbose startup output).
func (s Server) WithDebug(enabled bool) Server = s.copy(debug = enabled)

// WithBanner controls whether the startup banner is printed.
func (s Server) WithBanner(enabled bool) Server = s.copy(banner = enabled)

// WithWarmup registers a function that runs before the server accepts traffic.
func (s Server) WithWarmup(handler func()) Server = s.copy(wu = Some(handler))

// --- Serve (HTTP) ---

// ServeHTTP starts an HTTP server on the configured port.
func (s Server) ServeHTTP(h HTTP) Try[bool] = s.ServeHTTPOn(s":${s.Port}", h)

// ServeHTTPOn starts an HTTP server on the given address.
func (s Server) ServeHTTPOn(addr string, h HTTP) Try[bool] {
    val sb = h.buildServerBuilder()
    s.runWarmup()
    s.printBanner(addr, "HTTP", false, h.bannerLines(s.Debug))
    return Try(sb.ListenAndServe(addr)).Map((_) => true)
}

// ServeHTTPGraceful starts an HTTP server that drains on SIGINT/SIGTERM.
func (s Server) ServeHTTPGraceful(h HTTP) Try[bool] = s.ServeHTTPGracefulOn(s":${s.Port}", h)

// ServeHTTPGracefulOn starts a graceful HTTP server on the given address.
func (s Server) ServeHTTPGracefulOn(addr string, h HTTP) Try[bool] {
    val sb = h.buildServerBuilder()
    s.runWarmup()
    s.printBanner(addr, "HTTP", true, h.bannerLines(s.Debug))
    return Try(sb.ListenAndServeGraceful(addr, s.ShutdownTimeout)).Map((_) => true)
}

// --- Serve (HTTPS) ---

// ServeHTTPTLS starts an HTTPS server on the configured port.
func (s Server) ServeHTTPTLS(h HTTP, certFile string, keyFile string) Try[bool] =
    s.ServeHTTPTLSOn(s":${s.Port}", h, certFile, keyFile)

// ServeHTTPTLSOn starts an HTTPS server on the given address.
func (s Server) ServeHTTPTLSOn(addr string, h HTTP, certFile string, keyFile string) Try[bool] {
    val sb = h.buildServerBuilder()
    s.runWarmup()
    s.printBanner(addr, "HTTPS", false, h.bannerLines(s.Debug))
    return Try(sb.ListenAndServeTLS(addr, certFile, keyFile)).Map((_) => true)
}

// ServeHTTPGracefulTLS starts an HTTPS server that drains on SIGINT/SIGTERM.
func (s Server) ServeHTTPGracefulTLS(h HTTP, certFile string, keyFile string) Try[bool] =
    s.ServeHTTPGracefulTLSOn(s":${s.Port}", h, certFile, keyFile)

// ServeHTTPGracefulTLSOn starts a graceful HTTPS server on the given address.
func (s Server) ServeHTTPGracefulTLSOn(addr string, h HTTP, certFile string, keyFile string) Try[bool] {
    val sb = h.buildServerBuilder()
    s.runWarmup()
    s.printBanner(addr, "HTTPS", true, h.bannerLines(s.Debug))
    return Try(sb.ListenAndServeTLSGraceful(addr, certFile, keyFile, s.ShutdownTimeout)).Map((_) => true)
}

// --- Internal ---

func (s Server) runWarmup() {
    s.warmup match {
        case Some(handler) => handler()
        case None() => {}
    }
}

// printBanner writes the startup banner. The Server owns its shape — name,
// address, graceful timeout — and the protocol contributes the lines only it
// knows, so a TCP server does not print a route count it does not have.
func (s Server) printBanner(addr string, protocol string, graceful bool, extra Array[string]) {
    if !s.Banner {
        return
    }
    Println("")
    Println(s"   ${s.Name}")
    Println(s"   $protocol listening on $addr")
    extra.ForEach((line) => Println(s"   $line"))
    if graceful {
        Println(s"   Graceful shutdown: ${s.ShutdownTimeout}")
    }
    Println("")
}
